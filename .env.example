# Copy to .env for local development (never commit .env)

# Preferred: Kaggle API token (KGAT_...) for CLI dataset/kernel push
# Also used by `kaggle auth login` / access_token workflows.
# KAGGLE_API_TOKEN=KGAT_xxxxxxxx

# Legacy username/key pair (optional; older kaggle.json style)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Override data root for local work (default when unset: data/sample)
# RSNA_DATA_ROOT=data/sample          # synthetic CSV + DICOM
# RSNA_DATA_ROOT=data/kaggle          # official CSVs only (see data/kaggle/README.md)
